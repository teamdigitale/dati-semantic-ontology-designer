{
  "name": "ontology-designer",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "apigen": "run-s apigen:*",
    "apigen:clean": "rm -rf ./src/gen",
    "apigen:ai-assistant": "openapi-generator-cli generate -g typescript-fetch -c ./openapi-generator-config.json -o ./src/gen -i https://obdasystems.github.io/swaggers/bundled/ai-assistant.yaml",
    "version": "run-s build git-add-all",
    "git-add-all": "git add -A",
    "snapshot": "npm version prerelease --no-git-tag --preid=snap"
  },
  "files": [
    "dist"
  ],
  "main": "dist/ontology-designer.js",
  "module": "dist/ontology-designer.js",
  "types": "dist/ontology-designer.d.ts",
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@lit/react": "^1.0.8",
    "antd": "^5.21.6",
    "cytoscape-edgehandles": "^4.0.1",
    "exceljs": "^4.4.0",
    "js-base64": "^3.7.8",
    "mousetrap": "^1.6.5",
    "react-icons": "5.6.0",
    "react-markdown": "^10.1.0",
    "sparql-http-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@openapitools/openapi-generator-cli": "^2.28.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sparql-http-client": "^3.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "sass-embedded": "^1.100.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.16",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "peerDependencies": {
    "cytoscape": "3.31.1",
    "grapholscape": "github:obdasystems/grapholscape#v4.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
