# Backend (ai-assistant) environment variables.
# Copy to .env and set LLM/embedding keys to enable AI features.
#
# The backend starts without API keys and still handles OWL import/export.
# AI Design, Explain, and Generate require a configured LLM.

NO_AUTH=True
WORKING_DIR=/app/data/rag_storage
ENABLE_VDB_LOAD=True
PROMPTS_LANGUAGE=Italian
SUMMARY_LANGUAGE=italiano
IRI_LANGUAGE=italiano
IRI_FORMAT=camelCase

LLM_BINDING=openai
LLM_MODEL=
LLM_BINDING_HOST=
LLM_BINDING_API_KEY=

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=
EMBEDDING_DIM=1024
